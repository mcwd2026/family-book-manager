# SQLite 数据库文件位置（Docker 部署时默认 file:/app/data/dev.db）
DATABASE_URL="file:./dev.db"

# 豆瓣图书 API（用于扫码查书）
DOUBAN_API_BASE="https://api.douban.com"

# JWT 签名密钥：部署前请改成任意随机字符串（越长越安全）
JWT_SECRET="please-change-me-to-a-random-string"

# 首次启动自动创建的管理员账号（仅当数据库中无任何用户时生效）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="123456"
