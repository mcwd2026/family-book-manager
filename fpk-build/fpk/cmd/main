#!/bin/bash
# 家庭图书管理 FBM - fnOS 生命周期脚本
# 启动 Next.js 服务（HTTP 8112）
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
VAR_DIR="${TRIM_PKGVAR:-/tmp/fbm}"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
[ -z "$DATA_DIR" ] && DATA_DIR="${VAR_DIR}/data"

LOG_FILE="${VAR_DIR}/app.log"
PID_FILE="${VAR_DIR}/app.pid"
HTTP_PORT=8112

mkdir -p "$VAR_DIR" "$DATA_DIR"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

ensure_secret() {
  if [ ! -s "${VAR_DIR}/jwt.secret" ]; then
    head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n' > "${VAR_DIR}/jwt.secret"
  fi
}

prepare_db() {
  if [ ! -s "${DATA_DIR}/dev.db" ]; then
    cp "${APP_DIR}/db-template.db" "${DATA_DIR}/dev.db"
    log_msg "已初始化数据库"
  fi
  (
    cd "$APP_DIR" || exit 1
    DATABASE_URL="file:${DATA_DIR}/dev.db" \
      ADMIN_USERNAME="${ADMIN_USERNAME:-admin}" \
      ADMIN_PASSWORD="${ADMIN_PASSWORD:-123456}" \
      node seed.js >> "$LOG_FILE" 2>&1
  )
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  log_msg "启动 FBM..."
  ensure_secret
  prepare_db

  export DATABASE_URL="file:${DATA_DIR}/dev.db"
  export JWT_SECRET="$(cat "${VAR_DIR}/jwt.secret")"
  export COOKIE_SECURE=false
  export NODE_ENV=production
  export PORT="$HTTP_PORT"
  export HOSTNAME=0.0.0.0

  cd "$APP_DIR" || exit 1
  nohup node server.js >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  log_msg "停止 FBM..."
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid"; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  fi

  local i=0
  while [ "$i" -lt 10 ]; do
    local alive=0
    if [ -f "$PID_FILE" ]; then
      pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
      check_process "$pid" && alive=1
    fi
    [ "$alive" -eq 0 ] && break
    sleep 1
    i=$((i + 1))
  done

  if [ -f "$PID_FILE" ]; then
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    check_process "$pid" && kill -KILL "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
    ;;
esac
